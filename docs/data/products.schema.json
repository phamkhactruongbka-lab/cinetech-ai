{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CineTech product catalog",
  "type": "object",
  "required": [
    "schema_version",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "source_name",
          "source_url",
          "verified_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "affiliate_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
