# Cấu hình gửi email tự động qua Gmail (Miễn phí 100% - Chi phí 0 VNĐ)
SMTP_USER=your_email@gmail.com

# Mật khẩu ứng dụng (Google App Password) 16 ký tự tạo tại: https://myaccount.google.com/apppasswords
# (Không phải mật khẩu đăng nhập Gmail thông thường)
SMTP_PASSWORD=your_app_password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465


